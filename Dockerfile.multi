# Multi-stage Dockerfile for all components: crawler, api, web
# Default target builds the crawler

# ============================================================
# Builder stage
# ============================================================
FROM golang:1.26-alpine3.24 AS builder

WORKDIR /src

# Copy go mod files and download deps (cache layer)
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build all binaries
RUN CGO_ENABLED=0 GOOS=linux \
    go build -ldflags="-s -w -X main.version=v1.0.0 -X main.commit=docker -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /bin/crawler ./cmd/crawler && \
    go build -ldflags="-s -w -X main.version=v1.0.0 -X main.commit=docker -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /bin/api ./cmd/api

# ============================================================
# Node.js builder for Web UI
# ============================================================
FROM node:20-alpine AS web-builder

WORKDIR /web

# Install pnpm for faster installs
RUN npm install -g pnpm

# Copy web package files
COPY web/package.json web/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY web/ .
RUN pnpm run build

# ============================================================
# Runtime stage: crawler
# ============================================================
FROM alpine:latest AS runtime-crawler

RUN addgroup -S -g 1000 crawler && \
    adduser -S -u 1000 -G crawler crawler

RUN apk --no-cache add ca-certificates && \
    rm -rf /var/cache/apk/*

WORKDIR /app

COPY --from=builder /bin/crawler /usr/local/bin/crawler

RUN mkdir -p /data/registry /data/db /app/config && \
    chown -R crawler:crawler /data /app

USER crawler

VOLUME ["/data/registry", "/data/db", "/app/config"]

ENTRYPOINT ["crawler"]
CMD ["version"]

# ============================================================
# Runtime stage: api
# ============================================================
FROM alpine:latest AS runtime-api

RUN addgroup -S -g 1000 crawler && \
    adduser -S -u 1000 -G crawler crawler

RUN apk --no-cache add ca-certificates && \
    rm -rf /var/cache/apk/*

WORKDIR /app

COPY --from=builder /bin/api /usr/local/bin/api

RUN mkdir -p /data/registry /data/db /app/config && \
    chown -R crawler:crawler /data /app

USER crawler

VOLUME ["/data/registry", "/data/db", "/app/config"]

ENTRYPOINT ["/usr/local/bin/api"]
CMD ["--port", "8080"]

# ============================================================
# Runtime stage: web (nginx static server)
# ============================================================
FROM nginx:alpine AS web

COPY --from=web-builder /web/dist /usr/share/nginx/html

# Non-root nginx config
RUN sed -i 's/user nginx;/#user nginx;/' /etc/nginx/conf/nginx.conf && \
    echo 'user nobody;' > /etc/nginx/conf.d/default.conf && \
    echo 'worker_processes auto;' >> /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
