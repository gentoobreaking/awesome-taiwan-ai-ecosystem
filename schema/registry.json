{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taiwan AI Ecosystem Registry",
  "description": "Taiwan AI Ecosystem Registry Schema v2.0 - Canonical entity wrapper (spec §37, §44, T106). Entities array references entity.json.",
  "type": "object",
  "required": ["schema_version", "entities"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "crawler_version": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {"$ref": "entity.json#"}
    }
  }
}
