{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taiwan MCP Registry",
  "description": "Taiwan MCP Registry Schema v0.1 - Registry wrapper",
  "type": "object",
  "required": ["schema_version", "servers"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "crawler_version": {
      "type": "string"
    },
    "servers": {
      "type": "array",
      "items": {"$ref": "mcp-server.json#"}
    }
  }
}
