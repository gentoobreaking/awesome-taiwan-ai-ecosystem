{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Server",
  "description": "Taiwan MCP Registry Schema v0.1 - Single MCP Server. LEGACY: superseded by entity.json (v2.0, T106). Kept for backward-compatibility views of registry/REGISTRY.md.
  "type": "object",
  "required": ["id", "name", "slug", "description"],
  "properties": {
    "id": {
      "type": "string",
      "description": "sha256 hash of normalized canonical identity"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "region": {
      "type": "array",
      "items": {"type": "string"}
    },
    "category": {
      "type": "array",
      "items": {"type": "string"}
    },
    "taiwan_relevance": {
      "type": "object",
      "properties": {
        "level": {"type": "string", "enum": ["T0", "T1", "T2", "T3", "T4", "T5"]},
        "score": {"type": "number"},
        "confidence": {"type": "number"},
        "evidence": {"type": "array"}
      },
      "required": ["level", "score", "confidence"]
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": {"type": "string"},
        "host": {"type": "string"},
        "owner": {"type": "string"},
        "name": {"type": "string"},
        "stars": {"type": "integer", "minimum": 0},
        "forks": {"type": "integer", "minimum": 0},
        "language": {"type": "string"},
        "license": {"type": "string"},
        "archived": {"type": "boolean"},
        "last_commit_at": {"type": "string", "format": "date-time"}
      }
    },
    "endpoints": {"type": "array"},
    "capabilities": {
      "type": "object",
      "properties": {
        "tools": {"type": "array"},
        "resources": {"type": "array"},
        "prompts": {"type": "array"}
      }
    },
    "data_sources": {"type": "array"},
    "security": {"type": "object"},
    "health": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE", "INVALID", "UNKNOWN"]}
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "grade": {"type": "string", "enum": ["A", "B", "C", "D", "F"]}
      }
    },
    "sources": {"type": "array"},
    "evidence": {"type": "array"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": "string", "format": "date-time"}
  }
}
